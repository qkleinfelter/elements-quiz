{
  "name": "elements-quiz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tag, You're Obsolete - a quiz on obscure and deprecated HTML elements, with Solo and Kahoot-style Live modes.",
  "workspaces": ["site", "worker"],
  "scripts": {
    "site:dev": "npm run dev --workspace site",
    "site:build": "npm run build --workspace site",
    "site:deploy": "npm run deploy --workspace site",
    "worker:dev": "npm run dev --workspace worker",
    "worker:build": "npm run build --workspace worker",
    "worker:deploy": "npm run deploy --workspace worker",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "vitest": "^4.1.11"
  }
}
